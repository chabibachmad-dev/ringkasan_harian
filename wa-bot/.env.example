# Salin file ini jadi ".env" (jangan commit .env yang asli ke git!), lalu isi.

# Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Settings > API > service_role key (SECRET -- JANGAN
# dipakai di frontend/browser, cuma buat proses tepercaya seperti bot ini
# yang jalan di laptop sendiri).
SUPABASE_SERVICE_ROLE_KEY=

# Jarak polling cek pesan "pending" yang mau dikirim, dalam milidetik.
# Default 4000 (4 detik) kalau tidak di-set.
POLL_INTERVAL_MS=4000

# ---------- Auto-reply pakai AI (OPSIONAL, lihat README.md) ----------

# Set "true" buat NYALAKAN auto-reply AI (balas otomatis SEMUA pesan WA
# personal yang masuk, pakai Gemini, tanpa kamu baca/setujui dulu). Default
# MATI (apa pun selain persis "true" dianggap mati) -- sengaja default aman,
# baca dulu bagian "Auto-reply pakai AI" di README.md sebelum menyalakan.
WA_AUTO_REPLY_ENABLED=false

# Mesin AI yang dipakai auto-reply: "ollama" (DEFAULT -- model lokal lewat
# Ollama, gratis & privasi penuh, tapi WAJIB "ollama serve" + model-nya
# sudah ke-pull duluan di laptop ini) atau "gemini" (cara lama, lihat
# variabel GEMINI_* di bawah). Kosongkan/hapus baris ini = otomatis "ollama".
WA_AI_ENGINE=ollama

# ---- Khusus WA_AI_ENGINE=ollama ----
# Alamat server Ollama. Default http://127.0.0.1:11434 (Ollama jalan di
# laptop YANG SAMA dgn bot ini) -- cuma perlu diganti kalau Ollama-nya
# sengaja dijalankan di mesin lain di jaringan yang sama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Nama model Ollama yang sudah di-pull (`ollama pull qwen2.5:3b`).
OLLAMA_MODEL=qwen2.5:3b
# Ukuran jendela konteks (token) yang diminta ke Ollama. 4096 default aman
# buat RAM 7.5GB+model 3B -- naikkan kalau RAM-nya lega & mau histori lebih
# panjang, turunkan kalau laptop kerasa berat/lemot.
OLLAMA_NUM_CTX=4096
# Batas maksimal panjang jawaban (token) -- lihat README buat angka hasil
# tes kecepatan nyata (ollama run --verbose) yang dipakai nentuin default
# ini. Diturunkan = jawaban dipotong lebih pendek tapi lebih cepat & lebih
# jarang timeout; dinaikkan = jawaban bisa lebih panjang tapi lebih lambat.
OLLAMA_MAX_OUTPUT_TOKENS=300
# Berapa pesan terakhir (masuk+keluar) yang dikirim sbg riwayat ke Ollama --
# lebih pendek drpd punya Gemini (20) krn tiap pesan riwayat nambah waktu
# proses di CPU yang lambat.
OLLAMA_HISTORY_LIMIT=10
# Timeout tunggu jawaban Ollama (milidetik). CPU-only di laptop tua bisa
# SANGAT lambat (lihat README: hasil tes nyata cuma ~4.5 token/detik) --
# default 240000 (4 menit) sengaja longgar drpd auto-reply yg masih
# "mikir" dianggap gagal duluan.
OLLAMA_TIMEOUT_MS=240000

# ---- Khusus WA_AI_ENGINE=gemini ----
# API key Google AI Studio (https://aistudio.google.com/apikey). Wajib diisi
# kalau WA_AI_ENGINE=gemini. Boleh isi SATU key (GEMINI_API_KEY, nama lama,
# SAMA dengan yang dipasang sebagai secret GEMINI_API_KEY di Supabase
# Dashboard > Edge Functions > Secrets buat fitur "Obrolan AI") -- atau
# BEBERAPA key sekaligus dipisah koma lewat GEMINI_API_KEYS, kalau mau
# ROTASI otomatis antar akun Google begitu salah satu kena limit gratis
# harian (20 request/hari/akun):
#   GEMINI_API_KEYS=key-akun-1,key-akun-2,key-akun-3
# Tiap key HARUS dari akun Google (& project AI Studio) yang BEDA -- key
# dari akun yang sama semua kena limit bareng2, jadi rotasinya percuma.
# Kalau GEMINI_API_KEYS diisi, GEMINI_API_KEY (tunggal) diabaikan.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Opsional -- nama model Gemini, kosongkan buat pakai default (gemini-3.6-flash).
GEMINI_MODEL=

# ---------- Fitur tambahan bot (lihat README.md bagian "Fitur tambahan") ----------

# Nomor WA UTAMA kamu (bukan nomor bot ini) -- tujuan peringatan "semua API
# key habis" & ringkasan percakapan harian. Boleh format 08xx atau 628xx.
# Kosongkan = peringatan & ringkasan harian mati. Sengaja diisi di sini (bukan
# di kode) supaya nomor pribadi tidak ikut ke-commit ke GitHub.
WA_OWNER_NUMBER=

# Zona waktu buat jam ringkasan harian & jam yang disebut di pesan peringatan.
# Default Asia/Makassar (WITA). Waktu Jawa: Asia/Jakarta + label WIB.
WA_TIMEZONE=Asia/Makassar
WA_TIMEZONE_LABEL=WITA

# Ringkasan harian nyala otomatis kalau WA_OWNER_NUMBER diisi. Set "false"
# buat mematikannya. Jam kirim = jam berapa (0-23) di WA_TIMEZONE.
WA_DAILY_SUMMARY_ENABLED=true
WA_DAILY_SUMMARY_HOUR=20

# ---------- Ollama sebagai pembantu Gemini (opsional) ----------
# Butuh "ollama serve" jalan + model OLLAMA_MODEL sudah di-pull (lihat blok Ollama di atas).

# Mesin pembuat ringkasan harian: "ollama" (default; isi percakapan tidak keluar
# laptop & tidak makan kuota Gemini) atau "gemini".
WA_SUMMARY_ENGINE=ollama
# Kalau Ollama gagal, boleh jatuh ke Gemini? "false" = ketat (isi percakapan tidak
# pernah dikirim ke Google; gagal = daftar sederhana tanpa AI).
WA_SUMMARY_GEMINI_FALLBACK=true
# Batas tunggu ringkasan lokal (ms). Default 600000 (10 menit).
WA_SUMMARY_OLLAMA_TIMEOUT_MS=600000

# Saat Gemini gagal karena KUOTA, pertanyaan non-angka/aturan dijawab Ollama dulu.
WA_OLLAMA_FALLBACK_ENABLED=true
# Batas tunggu jawaban cadangan itu (ms) sebelum jatuh ke antrean. Default 90000.
WA_OLLAMA_FALLBACK_TIMEOUT_MS=90000

# ---- Penyedia AI CADANGAN: Groq & OpenRouter (opsional) ----
# Dipakai HANYA setelah semua key Gemini gagal/habis kuota (urutan: Gemini -> Groq -> OpenRouter).
# Mereka tidak punya Google Search; bot memakai pencarian Bing + dokumen seperti jalur "tanpa internet" Gemini.
# Daftar key dipisah koma (boleh dari akun berbeda). Kosongkan = tidak dipakai.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy
# Daftar model dicoba berurutan (jatah Groq dihitung per model). Cek nama terbaru di console.groq.com.
# GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant
# OPENROUTER_API_KEYS=sk-or-xxx
# Model gratis berakhiran :free; daftar berubah-ubah, cek openrouter.ai/models?q=free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Urutan penyedia cadangan (yang tidak ada key-nya dilewati)
# LLM_FALLBACK_ORDER=groq,openrouter
# Batas panjang prompt ke penyedia cadangan (karakter; jatah gratis mereka kecil), batas waktu per percobaan (ms), maks percobaan
# LLM_FALLBACK_MAX_INPUT_CHARS=14000
# LLM_FALLBACK_TIMEOUT_MS=30000
# LLM_FALLBACK_MAX_TRIES=6

# ---- Pencarian web lewat API (opsional; Gemini/Groq/OpenRouter tidak punya Google Search) ----
# Tanpa key apa pun, bot memakai Bing (scraping: hanya judul + cuplikan, tanpa URL). Dengan key di bawah, hasil
# lebih rapi dan membawa URL sumber. Urutan: Tavily -> Serper -> Brave -> Bing. Setiap penyedia boleh punya
# beberapa key (dipisah koma, dirotasi otomatis kalau jatah habis). Jatah gratis tiap penyedia berbeda dan bisa
# berubah -- cek di situsnya: tavily.com, serper.dev, brave.com/search/api.
# TAVILY_API_KEYS=tvly-xxx,tvly-yyy
# SERPER_API_KEYS=xxx
# BRAVE_API_KEYS=xxx
# SEARCH_ORDER=tavily,serper,brave
# SEARCH_BING_FALLBACK=true
# SEARCH_TIMEOUT_MS=8000

# ---- Pantauan perubahan peraturan (mingguan, dikirim ke WA_OWNER_NUMBER) ----
# Nyala otomatis kalau WA_OWNER_NUMBER terisi DAN ada key API pencarian (TAVILY_API_KEYS / SERPER_API_KEYS /
# BRAVE_API_KEYS di atas; Bing tidak cukup karena tak bisa menyaring tanggal). Tiap minggu bot mencari kabar
# terbaru, membuang yang sudah pernah dilaporkan, memisahkan sumber resmi (.go.id) dari berita, meminta AI
# (Ollama/Gemini, ikut WA_SUMMARY_ENGINE) menyaring & merangkum, lalu mengirimnya ke WhatsApp-mu.
# Perintah dari nomor pemilik: /peraturan (jalankan sekarang) atau /peraturan semua (tampilkan semua hasil terbaru
# lagi, buat tes). Memakai sekitar 4 pencarian per minggu (1 per topik).
# REG_MONITOR_ENABLED=true
# Topik: "Label|kata pencarian" dipisah titik koma; {year} diganti tahun berjalan. Kosong = 4 topik bendahara bawaan.
# REG_MONITOR_TOPICS=PMK & perbendaharaan|Peraturan Menteri Keuangan terbaru perbendaharaan negara {year};Pajak belanja|ketentuan baru pajak bendahara pemerintah {year}
# Hari (0=Minggu ... 6=Sabtu; bawaan 1=Senin) dan jam lokal (bawaan 7)
# REG_MONITOR_DAY=1
# REG_MONITOR_HOUR=7
# Seberapa baru hasil yang dicari: week | month | year (bawaan month; yang sudah pernah dilaporkan tidak diulang)
# REG_MONITOR_RECENT=month
# REG_MONITOR_MAX_ITEMS=8
# Akhiran domain yang dianggap sumber resmi (dipisah koma)
# REG_MONITOR_OFFICIAL_DOMAINS=go.id

# ---- Grup WhatsApp (default MATI) ----
# Bot hanya menjawab di grup yang namanya ada di daftar ini DAN saat dipanggil.
# Cukup potongan nama (huruf besar-kecil, emoji, tanda baca diabaikan). Pisah koma.
# WA_GROUP_ALLOWED_NAMES=Salim Family
# Alternatif/tambahan: id grup (lihat di log kalau bot dipanggil di grup yg belum diizinkan)
# WA_GROUP_ALLOWED_JIDS=120363000000000000@g.us
# Pemicu: mention nomor bot (default true). Matikan kalau hanya mau pakai kata pemicu.
# WA_GROUP_MENTION_TRIGGER=true
# Kata pemicu di awal pesan (opsional), mis. "bot,ai" -> "bot, apa itu halal?"
# WA_GROUP_KEYWORDS=
# Jeda minimal antar pertanyaan dari orang yang sama di grup (detik). Bawaan 0 = SETIAP mention/reply ke bot dijawab
# WA_GROUP_COOLDOWN_SEC=0
# Dokumen Pengetahuan di grup: "keywords" (bawaan) = hanya bila pesan memuat kata seperti tarif/aturan/pmk;
# "always" = tiap pertanyaan yang memanggil bot dicarikan di dokumen (pencarian lokal, tanpa biaya).
# WA_GROUP_DOCS=keywords
# KUNCI dokumen acuan grup: hanya dokumen yang judulnya memuat salah satu potongan ini yang dipakai di grup,
# dan jawabannya HANYA dari dokumen itu (tanpa Google/Bing). Pisah koma, huruf besar-kecil diabaikan.
# Kosongkan = semua dokumen boleh dipakai (+ pencarian web bila pesan memuat kata kunci).
# WA_GROUP_DOC_TITLES=Surat Edaran

# ---- SiMAB lewat WhatsApp (baca + rekam kegiatan, default MATI) ----
# Project Supabase SiMAB (BERBEDA dari SUPABASE_URL di atas). Kunci anon/publishable
# boleh dipakai; JANGAN pakai service_role. Akun bot dibuat di Dashboard SiMAB lalu
# dibatasi baca-saja dengan simab-bot-readonly.sql.
# SIMAB_SUPABASE_URL=https://xxxx.supabase.co
# SIMAB_SUPABASE_ANON_KEY=
# SIMAB_BOT_EMAIL=bot-wa@simab.local
# SIMAB_BOT_PASSWORD=
# Kode satker yang boleh dilihat bot (default 538065) dan tahun tetap (default: config.tahun_aktif)
# SIMAB_KANTOR_ID=538065
# SIMAB_TAHUN=
# Akun yang dihitung sebagai perjalanan dinas utk perintah "simab perjadin" (pisah koma, default 524111,524113)
# SIMAB_PERJADIN_AKUN=524111,524113
# Perekaman kegiatan ("simab rekam <seksi>"): butuh simab-bot-rekam.sql di database SiMAB.
# SIMAB_REKAM_ENABLED=true
# Nama yang tercatat di kolom "user" kegiatan hasil rekam dari WhatsApp
# SIMAB_REKAM_USER=Bot WhatsApp
# Sesi rekam kedaluwarsa setelah sekian menit tanpa balasan (default 10)
# SIMAB_REKAM_TTL_MIN=10
# Meterai ("simab rekam meterai" / "simab meterai <jumlah>"): kode MAK meterai persis, pisah koma.
# Kosong = deteksi otomatis dari kode terpanjang yang uraiannya memuat kata di SIMAB_METERAI_KATA.
# SIMAB_METERAI_MAK=
# SIMAB_METERAI_KATA=meterai,materai
# Uraian bawaan bila hanya mengirim jumlah
# SIMAB_METERAI_URAIAN=Pembelian meterai
# Hanya kalau nomor pemilik terbaca sbg id "@lid" (lihat log "perintah ditolak"): id lid-nya, pisah koma
# WA_OWNER_LIDS=

# ---- Jeda auto-reply saat kamu membalas manual ----
# Berapa menit bot diam di sebuah chat setelah KAMU membalas chat itu sendiri
# (dari HP/aplikasi). 0 = dimatikan. Ketik "AI On" di chat itu untuk aktif lagi.
# WA_MANUAL_PAUSE_MINUTES=60
# true = bot menghapus (untuk semua orang) pesan "AI On" yang kamu ketik di chat kontak
# WA_AI_ON_DELETE_COMMAND=false

# ---- Agen Ollama untuk chat di APLIKASI (pilihan Auto/Gemini/Ollama; butuh migration 0015) ----
# Bot juga mengerjakan antrean chat dari aplikasi memakai Ollama lokal (OLLAMA_BASE_URL &
# OLLAMA_MODEL di atas). Tidak ada pesan WhatsApp yang dikirim; tidak ada port yang dibuka.
# false = matikan fitur ini.
# APP_AGENT_ENABLED=true
# Jendela konteks khusus chat aplikasi (token). Lebih besar dari OLLAMA_NUM_CTX (auto-reply WA)
# karena ada riwayat + potongan dokumen. Turunkan ke 4096 kalau RAM laptop sempit.
# OLLAMA_CHAT_NUM_CTX=8192
# Panjang jawaban maksimum (token). Laptop CPU-only ~4-5 token/detik: 700 token ~ 2,5 menit.
# OLLAMA_CHAT_MAX_OUTPUT_TOKENS=700
# Batas waktu satu panggilan Ollama (ms) & jumlah pesan riwayat yang dikirim
# OLLAMA_CHAT_TIMEOUT_MS=600000

# Anti-halusinasi saat membaca dokumen:
# Suhu model saat dokumen/lampiran ikut dibaca (0 - 1). Rendah = patuh pada teks, tidak berimajinasi. Default 0.1
# OLLAMA_DOC_TEMPERATURE=0.1
# Ukuran potongan dokumen (karakter) & overlap antar-potongan. Default 1000 & 150.
# Setelah mengubahnya, isi KB_REINDEX=true SEKALI, restart bot, lalu hapus lagi barisnya (dokumen lama disusun ulang dari teks tersimpan, tanpa OCR ulang).
# KB_CHUNK_CHARS=1000
# KB_CHUNK_OVERLAP=150
# KB_REINDEX=false
# Periksa mutu teks PDF: halaman berantakan dicoba di-OCR ulang & dilaporkan di daftar Dokumen Pengetahuan. Default on.
# KB_QUALITY_CHECK=on
# OLLAMA_CHAT_HISTORY_LIMIT=12
# Pertanyaan biasa ke dokumen: total karakter potongan dokumen relevan yang disisipkan
# OLLAMA_CHAT_RAG_BUDGET_CHARS=5000
# Permintaan menyeluruh ("ringkas/analisis dokumen"): dokumen dipecah per bagian ~5000
# karakter; paling banyak 6 bagian dibaca (dipilih merata) supaya tidak berjam-jam.
# OLLAMA_DOC_CHUNK_CHARS=5000
# OLLAMA_DOC_MAX_CHUNKS=6

# ---- Notifikasi push dari bot (jawaban Ollama selesai, pengingat khatam) ----
# Isi dengan nilai CRON_SECRET yang SAMA dengan secret di Supabase (dipakai Edge Function send-push).
# Tanpa ini, push dimatikan (fitur lain tetap jalan). JANGAN di-commit.
# CRON_SECRET=
# Push "jawaban Ollama sudah siap" hanya dikirim kalau job lebih lama dari ini (detik); 0 = selalu.
# APP_AGENT_NOTIFY_MIN_SECONDS=20
# Lampiran chat yang totalnya <= ini (karakter) disisipkan utuh ke prompt Ollama; yang lebih panjang
# dibaca per bagian / diambil potongan relevannya.
# OLLAMA_ATTACH_INLINE_CHARS=6000
# Jam pengingat khatam harian (zona WA_TIMEZONE); hanya dikirim bila target hari ini belum tercapai.
# KHATAM_REMINDER_TIME=20:30

# ---- Dokumen Pengetahuan: ingest PDF di laptop (butuh migration 0017, lihat README bagian 9) ----
# KB_INGEST_ENABLED=true
# Lokasi indeks pencarian SQLite (default: wa-bot/kb/kb.sqlite).
# KB_INDEX_FILE=
# Salinan teks ke Supabase untuk Gemini dipotong di sini (karakter). Indeks Ollama di laptop tetap UTUH.
# KB_SYNC_MAX_CHARS=600000
# OCR halaman scan (auto = pakai bila tesseract terpasang; off = matikan).
# KB_OCR=auto
# Bahasa OCR; kosong = otomatis (ind+eng bila ada).
# KB_OCR_LANG=
# KB_OCR_MAX_PAGES=300
# KB_OCR_DPI=200

# ---- Antrean Ollama & RAM (lihat README bagian 10) ----
# Lama model dibiarkan di RAM setelah panggilan terakhir (format Ollama: 30s, 5m, 0).
# OLLAMA_KEEP_ALIVE=5m
# Tiap sekian ms menunggu, prioritas pekerjaan di antrean naik satu tingkat (mencegah kelaparan).
# OLLAMA_QUEUE_AGING_MS=120000

# Chat aplikasi dengan Dokumen Pengetahuan/lampiran aktif: riwayat dipangkas
# supaya prompt lebih kecil (jawaban lebih cepat di CPU lambat).
# OLLAMA_DOC_HISTORY_LIMIT=4
# OLLAMA_DOC_HISTORY_CLIP_CHARS=700
# Batas waktu satu jawaban chat aplikasi (ms). Default 10 menit.
# OLLAMA_CHAT_TIMEOUT_MS=600000

# --- Gemini membaca dokumen lewat indeks laptop (migrations/0019) ---
# KB_RETRIEVAL_ENABLED=true
# KB_RETRIEVAL_POLL_MS=2000
# KB_RETRIEVAL_MAX_BUDGET_CHARS=30000
# GEMINI_RAG_BUDGET_CHARS=10000   # jalur WhatsApp (mesin Gemini): total karakter potongan dokumen
# GEMINI_RAG_MAX_CHUNKS=8
# KB_MIN_COVERAGE=0.5   # 0 = matikan penyaringan cakupan kata; 0.7 = lebih ketat (pertanyaan di luar dokumen -> hasil kosong)

# ---------- Telegram untuk pemilik (OPSIONAL, lihat README bagian 9d) ----------
# MATI selama TELEGRAM_BOT_TOKEN kosong -- bot WhatsApp tetap jalan persis seperti biasa.
# 1) Di Telegram buka @BotFather > /newbot > salin token-nya ke sini.
# 2) Restart bot, kirim pesan apa saja ke bot kamu: ia membalas dengan id chat-mu (mode pairing).
# 3) Isi TELEGRAM_OWNER_IDS dengan id itu, restart lagi. Hanya id di daftar ini yang dilayani.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_IDS=
# Ringkasan harian, pantauan peraturan, dan peringatan "semua key habis" ikut dikirim ke Telegram.
# TELEGRAM_MIRROR_NOTIFICATIONS=true
# Jumlah pesan terakhir yang dikirim ke AI sebagai konteks obrolan (2-40).
# TELEGRAM_HISTORY_LIMIT=12

# ---------- Pesan SUARA di Telegram (OPSIONAL) ----------
# Kirim pesan suara (tahan tombol mikrofon) ke bot Telegram: bot menuliskan apa yang terdengar, lalu menjalankannya seperti teks
# (obrolan AI, atau alur "simab rekam"/pilih nomor/ya/batal). Mesin utama: Groq Whisper (gratis, memakai GROQ_API_KEYS di atas);
# cadangan: Gemini (GEMINI_API_KEYS). Tanpa keduanya, pesan suara dijawab "belum aktif".
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GEMINI_STT_MODEL=            # kosong = pakai GEMINI_MODEL
# VOICE_LANGUAGE=id            # bahasa ucapan (kode ISO-639-1) untuk Whisper
# VOICE_MAX_SECONDS=180        # pesan suara lebih panjang ditolak

# ---------- Balasan SUARA & tutor Inggris di Telegram (OPSIONAL; butuh ffmpeg: sudo apt install ffmpeg) ----------
# Bot membalas dengan voice note (Gemini TTS -> OGG/Opus). Memakai GEMINI_API_KEYS di atas. Perintah: /suara auto|on|off, /speak [topik], /selesai.
# GEMINI_TTS_MODELS=           # daftar model suara dicoba berurutan (kosong = bawaan)
# TELEGRAM_TTS_VOICE=Sulafat   # suara Gemini: Aoede, Achird, Zephyr, Puck, Kore, ... (GEMINI_TTS_VOICE juga dibaca)
# TTS_MAX_CHARS=700            # batas teks yang diucapkan (teks balasan tetap lengkap)
# FFMPEG_PATH=ffmpeg           # lokasi ffmpeg bila tidak ada di PATH
# TELEGRAM_SPEAK_MAX_TURNS=30  # batas giliran satu sesi /speak
# TELEGRAM_SPEAK_IDLE_MIN=60   # sesi /speak berakhir bila diam sekian menit
# TELEGRAM_SPEAK_TEXT=false    # false (bawaan) = tutor SUARA SAJA; true = juga ditulis. Selama sesi: /teks on|off, /koreksi
# TUTOR_AI_ORDER=fallback-first # tutor memakai Groq/OpenRouter dulu (bawaan, cepat); gemini-first = Gemini dulu

# --- Suara di WhatsApp (memakai kunci STT/TTS yang sama dengan di atas) ---
# WA_VOICE_FROM_OTHERS=true   # voice note kontak lain di chat pribadi diubah jadi teks lalu dijawab auto-reply (teks)
# WA_VOICE_IN_GROUPS=true     # di grup: voice note yang membalas (reply) pesan bot ikut dijawab
# WA_SPEAK_MAX_TURNS=30       # batas giliran satu sesi /speak di WhatsApp
# WA_SPEAK_IDLE_MIN=60        # sesi /speak WhatsApp berakhir bila diam sekian menit
# WA_SPEAK_TEXT=false          # false (bawaan) = tutor SUARA SAJA (tanpa teks balasan & tanpa echo ucapanmu); true = juga ditulis. Selama sesi: /teks on|off, /koreksi


# ---------- 13. Dokumen lokal: PDF peraturan -> .md -> bisa ditanyakan (HANYA dijawab Ollama) ----------
# Taruh PDF di <DOC_DIR>/peraturan-pdf/ (boleh subfolder). Bot mengubahnya jadi .md terstruktur (BAB/Pasal/ayat/tabel)
# di <DOC_DIR>/peraturan-md/ dan mengindeksnya. .md boleh kamu sunting; suntingan tidak ditimpa.
# Dokumen ini TIDAK PERNAH dikirim ke Gemini/Groq/OpenRouter. Bawaan DOC_DIR = folder "dokumen" sejajar dengan wa-bot/.
# DOC_FOLDER_ENABLED=true
# DOC_DIR=/home/abuayyubb/ringkasan_harian/dokumen
# DOC_POLL_MS=20000     # seberapa sering folder dicek
# DOC_MAX_MB=300        # PDF lebih besar dari ini ditolak
# Menanyakan dokumen lokal: chat aplikasi (mesin Ollama + toggle Dokumen), atau /dokumen <pertanyaan> di WhatsApp/Telegram (hanya pemilik).
# DOC_LOCAL_BUDGET_CHARS=3500   # teks dokumen yang dibaca model untuk /dokumen (1500-12000)
# DOC_LOCAL_WA_CONTACTS=false   # true = balasan otomatis Ollama ke kontak/grup juga boleh memakai dokumen lokal

# Arsip PDF grup: PDF yang diunggah di grup WhatsApp (nomor utama) otomatis disimpan di laptop & diindeks (BM25 lokal, TIDAK ke Jina),
# lalu dipakai menjawab pertanyaan di grup YANG SAMA tanpa melampirkan PDF. Pemilik: /arsip di Telegram.
# ARSIP_ENABLED=true            # false = tidak mengarsipkan sama sekali
# ARSIP_DIR=arsip-dokumen       # folder berkas <sha256>.pdf + indeks.sqlite (relatif ke wa-bot/)
# ARSIP_PEMBERITAHUAN=on        # off = jangan beri tahu grup (satu kali per grup) bahwa PDF disimpan

# Pemilik di grup WhatsApp (nomor utama): dipanggil hormat & dipatuhi; bot menandai pemilik bila tidak bisa menjawab. Pemilik dikenali dari id pengirim
# (WA_OWNER_NUMBER / WA_OWNER_LIDS), bukan dari klaim di isi pesan.
# WA_OWNER_PANGGILAN=Bos         # panggilan untuk pemilik di grup
# WA_TANYA_BOS=on                # off = bot tidak pernah me-mention pemilik saat tidak tahu jawabannya
# WA_TANYA_BOS_JEDA_MENIT=30     # paling banyak 1 mention pemilik per grup per sekian menit

# ---------------------------------------------------------------- 14. Perintah laptop dari Telegram (MATI bawaan)
# /sistem  /log  /restart  /deploy chat|study  /migrasi — hanya dari chat pribadi pemilik di Telegram, tanpa shell bebas,
# perintah yang mengubah sesuatu minta konfirmasi "/ya <kode>" (60 detik), semua tercatat di wa-bot/ops-audit.log.
# Butuh: pm2 dan npx (supabase CLI sudah login/terhubung) bisa dijalankan dari proses bot.
# OPS_ENABLED=false
# OPS_TELEGRAM_IDS=            # kosong = semua TELEGRAM_OWNER_IDS; isi untuk mempersempit
# OPS_PROJECT_DIR=             # bawaan: folder induk wa-bot (tempat supabase/ berada)
# OPS_PM2_NAME=wa-bot
# OPS_FUNCTIONS=chat,study,office     # daftar putih untuk /deploy
# OPS_CONFIRM_TTL_SEC=60
# OPS_DEPLOY_TIMEOUT_SEC=240
# /migrasi memakai `npx supabase db push`. Bila CLI meminta konfirmasi/kata sandi (bot tidak bisa mengetik), isi:
# OPS_DB_PUSH_ARGS=--yes             # opsi tambahan untuk db push (hanya opsi sederhana)
# SUPABASE_DB_PASSWORD=...           # kata sandi database; dibaca CLI dari env (disamarkan dari keluaran bot)
# Patch zip & Git dari Telegram (ikut aktif bersama OPS_ENABLED; matikan satu per satu bila perlu):
# OPS_PATCH_ENABLED=true       # kirim berkas patch*.zip ke bot -> diperiksa, dicadangkan, diterapkan setelah /ya <kode>
# OPS_PATCH_PREFIX=patch       # zip harus bernama diawali ini (mencegah salah kirim)
# OPS_PATCH_CONFIRM_TTL_SEC=180
# OPS_GIT_ENABLED=true         # /git /commit /push /rilis (butuh git sudah bisa push tanpa kata sandi: kunci SSH tanpa passphrase, atau HTTPS + credential helper)
# OPS_TEST_TIMEOUT_SEC=600     # batas waktu /tes (npm test)
# OPS_GIT_TIMEOUT_SEC=120

# ---------------------------------------------------------------- 15. Jaringan (bila log sering menampilkan "fetch failed")
# NET_IPV4_FIRST=true           # IPv4 dulu (bawaan). false = urutan DNS bawaan Node
# NET_AUTOSELECT_FAMILY=false   # bawaan: mati (hanya satu alamat per koneksi, IPv4). true = Node mencoba IPv6 dulu lalu IPv4 (rusak bila IPv6 buntu)
# NET_ATTEMPT_TIMEOUT_MS=3000   # hanya berlaku bila NET_AUTOSELECT_FAMILY=true

# ---------------------------------------------------------------- 16. Catatan pribadi (/ingat) dan status penyedia (/penyedia)
# /penyedia tidak butuh pengaturan. /ingat /catatan /lupa menyimpan catatan di SQLite lokal (wa-bot/memori.sqlite, tidak ikut Git),
# hanya dibaca Ollama lokal (chat aplikasi + /dokumen), tidak pernah dikirim ke Gemini/Groq/OpenRouter atau kontak WhatsApp.
# OWNER_MEMORY_ENABLED=true
# OWNER_MEMORY_MAX=50                # jumlah catatan maksimal
# OWNER_MEMORY_BUDGET_CHARS=1200     # batas teks catatan yang disisipkan ke prompt (300-4000)
# OWNER_MEMORY_FILE=                 # bawaan: wa-bot/memori.sqlite

# ---------------------------------------------------------------- 17. Pasar pagi: IHSG + emas dunia + kurs (aktif bawaan)
# Dikirim ke pemilik (WhatsApp + Telegram) tiap pagi hari kerja; /pasar (alias /emas, /ihsg) = sekarang juga.
# Sumber berlapis tanpa API key (tidak resmi): IHSG Yahoo->Stooq->Google Finance; emas xaus.com->Yahoo->Stooq; kurs ExchangeRate-API->Yahoo->Stooq. /pasar tes = uji tiap sumber. Emas = harga emas dunia dikonversi ke Rp/gram, BUKAN harga Antam.
# MARKET_BRIEF_ENABLED=true
# MARKET_BRIEF_TIME=07:30           # zona waktu WA_TIMEZONE
# MARKET_BRIEF_DAYS=1-5             # 0=Minggu ... 6=Sabtu
# MARKET_BRIEF_LATE_MIN=180         # bot baru menyala lewat jam kirim: masih dikirim sampai sekian menit, lewat itu dilewati
# MARKET_IHSG_SYMBOL=^JKSE
# MARKET_GOLD_SYMBOL=GC=F
# MARKET_FX_SYMBOL=IDR=X
# MARKET_IHSG_STOOQ=^jci            # simbol cadangan di Stooq
# MARKET_GOLD_STOOQ=xauusd
# MARKET_FX_STOOQ=usdidr
# MARKET_STOOQ_APIKEY=              # Stooq mewajibkan key sejak 2026-04: buka https://stooq.com/q/d/?s=^jci&get_apikey, isi captcha, salin nilai apikey= dari tautan CSV di bawah halaman. Kosong = Stooq dilewati
# MARKET_TIMEOUT_MS=15000

# ---------------------------------------------------------------- 18. Pengingat pribadi (/ingatkan, /pengingat) -- aktif bawaan
# /ingatkan besok 09:00 kirim SPJ   |   /ingatkan tiap tanggal 25 jam 08:00 laporan   |   /pengingat (daftar)   |   /pengingat batal <nomor>
# Disimpan di wa-bot/pengingat.sqlite (hanya di laptop), dikirim ke WhatsApp + Telegram pemilik. Waktu mengikuti WA_TIMEZONE.
# REMINDERS_ENABLED=true
# REMINDERS_FILE=            # bawaan: wa-bot/pengingat.sqlite
# IBADAH_ENABLED=true       # pengingat ibadah: /ibadah (juz harian, hadits, ayat)
# IBADAH_FILE=              # bawaan: wa-bot/ibadah.sqlite

# ---------------------------------------------------------------- 19. Cadangan otomatis (/cadangan) -- aktif bawaan
# Tiap hari menyalin catatan (/ingat), pengingat, skill, dan sesi WhatsApp ke folder bertanggal; yang lama dirotasi.
# Folder cadangan berisi sesi WhatsApp: jangan dibagikan, jangan masuk Git. Arahkan ke disk lain / folder yang disinkronkan bila bisa.
# BACKUP_ENABLED=true
# BACKUP_TIME=02:30                  # zona waktu WA_TIMEZONE; bot baru menyala lewat jam ini dan belum ada cadangan hari ini -> langsung dibuat
# BACKUP_KEEP=7                      # jumlah cadangan terakhir yang disimpan (1-60)
# BACKUP_DIR=~/cadangan-ayyubi
# BACKUP_INCLUDE_ENV=false           # true = .env (berisi key rahasia) ikut disalin
# BACKUP_NOTIFY_OK=false             # true = kabari tiap cadangan sukses (gagal selalu dikabari)

# ---------------------------------------------------------------- 20. Penjaga kesehatan bot (/kesehatan) -- aktif bawaan
# Memeriksa tiap beberapa menit; kamu dikabari (WhatsApp + Telegram) SEKALI saat bermasalah dan SEKALI saat pulih.
# HEALTH_ENABLED=true
# HEALTH_INTERVAL_MIN=5
# HEALTH_OLLAMA=true               # false bila kamu memang sering mematikan Ollama (hindari peringatan)
# HEALTH_DISK_MIN_GB=3             # peringatan bila sisa disk (bot / folder cadangan) di bawah ini
# HEALTH_MEM_MIN_MB=300            # peringatan bila RAM tersedia di bawah ini 3 kali berturut-turut
# HEALTH_WA_DOWN_MIN=10            # peringatan bila WhatsApp tidak tersambung selama ini
# HEALTH_RESTARTS=5                # peringatan bila bot menyala sebanyak ini dalam 15 menit (crash loop)

# ---------------------------------------------------------------- 21. Urutan AI balasan WA & batas waktu (semua OPSIONAL)
# Urutan penyedia (jalur santai & akurat) TIDAK diatur di sini, tetapi lewat perintah /urutan (disimpan di bot_state).
# Batas waktu satu panggilan Gemini untuk balasan WA/grup (milidetik, bawaan 25000) dan untuk tugas lain (bawaan 90000):
# GEMINI_WA_TIMEOUT_MS=25000
# GEMINI_TIMEOUT_MS=90000

# ---------------------------------------------------------------- 22. Konsep Nota Dinas LPJ Bendahara tiap tanggal 1 (/nodin) -- aktif bawaan, semua OPSIONAL
# Tiap tanggal 1 bot mengirim konsep (PDF + Word) bulan sebelumnya ke WhatsApp + Telegram. PDF dibuat LibreOffice:
#   sudo apt install libreoffice-writer      (cek: soffice --version). Tanpa LibreOffice, hanya Word yang dikirim.
# NODIN_ENABLED=true
# NODIN_DAY=1                        # tanggal kirim (1-28)
# NODIN_TIME=07:00                   # zona waktu WA_TIMEZONE; jika bot mati/terlambat, dikejar sampai NODIN_LATE_DAYS hari
# NODIN_LATE_DAYS=5
# NODIN_PDF=true                     # false = Word saja
# NODIN_TEMPLATE=                    # jalur templat .docx lain; bawaan templates/nota-dinas-lpj.docx
# NODIN_SOFFICE=                     # jalur soffice bila tidak ada di PATH

# ---------------------------------------------------------------- 23. Laporan kas bulanan (/kas) -- aktif bawaan, semua OPSIONAL
# Tiap awal bulan bot menyiapkan rancangan "Laporan Saldo Rekening + Register Penutupan Kas" bulan lalu, kamu konfirmasi angkanya
# lewat /kas, lalu /kas submit menyimpan data (tabel bot_state) dan membuat PDF + Word. Pengingat sekali sehari sampai disubmit.
# PDF memakai LibreOffice yang sama dengan nota dinas (bagian 22).
# KAS_ENABLED=true
# KAS_DAY=1                          # rancangan dibuat mulai tanggal ini (1-28)
# KAS_TIME=07:10                     # zona waktu WA_TIMEZONE
# KAS_PDF=true                       # false = Word saja

# ---------------------------------------------------------------- 24. Balasan suara di grup WhatsApp (/voice wag on|off) -- semua OPSIONAL
# Dinyalakan/dimatikan dari Telegram dengan /voice wag on|off (disimpan di bot_state). Butuh GEMINI_API_KEYS dan ffmpeg.
# WA_GROUP_VOICE_MAX_CHARS=600       # jawaban lebih panjang dari ini dikirim teks (80-1500; juga dibatasi TTS_MAX_CHARS)
# WA_GROUP_VOICE_TIMEOUT_MS=30000    # batas waktu membuat suara; lewat itu dikirim teks
# WA_VOICE=                         # suara Ayyubi di grup (mis. Puck); lebih mudah lewat Telegram: /suara pakai ayyubi Puck anak laki-laki ceria
# WA_VOICE_STYLE=                    # gaya bicara Ayyubi (kalimat bebas)
# WA2_VOICE=                         # suara bot nomor kedua (mis. Charon)
# WA2_VOICE_STYLE=                   # gaya bicara bot nomor kedua
# WA_GROUP_FILE_MAX_PER_DAY=10       # jatah berkas PDF/Word/Excel per orang per hari di grup (0 = tanpa batas)
# --- Baca/tanya isi PDF di grup (PDF dilampirkan atau PDF yang dibalas) ---
# WA_GROUP_PDF_READ=on                  # off = fitur baca PDF di grup dimatikan
# WA_GROUP_PDF_READ_MAX_PER_DAY=15      # jatah baca PDF per orang per hari (0 = tanpa batas)
# WA_GROUP_PDF_MAX_CHARS=36000          # batas teks PDF yang dikirim ke AI API (Gemini dll)
# WA_GROUP_PDF_LOCAL_MAX_CHARS=12000    # batas untuk model lokal (Ollama)
# WA_GROUP_PDF_NUM_CTX=8192             # jendela konteks Ollama khusus pertanyaan PDF (token)

# --- Jadwal kantor di grup (agenda.js): catat/tanya jadwal, rekap pagi, pengingat sebelum acara. Tanpa AI. Lihat README.
# AGENDA_ENABLED=true                # false = matikan seluruh fitur jadwal grup
# AGENDA_SUGGEST=true                # false = bot tidak menawarkan "Mau saya catat sebagai jadwal?" dari obrolan biasa
# AGENDA_MORNING_TIME=07:30          # jam rekap jadwal hari itu (zona WA_TIMEZONE); hari tanpa jadwal = bot diam
# AGENDA_REMIND_BEFORE_MIN=30        # ingatkan sekian menit sebelum acara (0 = mati)
# AGENDA_MAX_PER_GROUP=200           # batas jadwal tersimpan per grup
# AGENDA_FILE=./agenda.sqlite        # lokasi berkas jadwal

# Gudang pengetahuan + tebak-tebakan grup (/tebak di Telegram; "bot, tebak-tebakan dong" di grup). SQLite lokal, ikut cadangan malam.
# TEBAKAN_ENABLED=true               # false = fitur mati
# TEBAKAN_FILE=./pengetahuan.sqlite  # lokasi basis data
# TEBAKAN_AWAL_FILE=./data/tebakan-awal.txt  # berkas data awal untuk "/tebak impor-awal"
# TEBAKAN_TTL_MIN=15                 # permainan tanpa pemenang ditutup otomatis setelah sekian menit

# ---------------------------------------------------------------- 25. Nomor WhatsApp kedua (/wa2) -- MATI bawaan, semua OPSIONAL
# Jalankan dulu migrasi supabase/migrations/0039_whatsapp_account.sql (/migrasi terapkan). Bot lalu mengirim KODE TAUTAN ke kamu
# untuk diteruskan ke pemegang HP nomor itu (WhatsApp > Perangkat Tertaut > Tautkan dengan nomor telepon).
# WA2_NUMBER=0812xxxxxxx             # nomor kedua; mengisinya otomatis menyalakan fitur ini
# WA2_ENABLED=true                   # false = matikan walau WA2_NUMBER diisi
# WA2_NAME=Wongsobot                # nama bot di nomor kedua: AI memperkenalkan diri dengan nama ini (bawaan Ayyubi) + nama di pesan status
# WA2_LABEL=Nomor 2                  # nama di pesan status saja (bila beda dari WA2_NAME)
# WA2_AUTH_DIR=auth_session_2        # folder sesi login nomor kedua (ikut cadangan otomatis, jangan dibagikan)
# WA2_GROUP_ALLOWED_NAMES=           # grup yang dijawab nomor kedua (pisah koma); kosong = tidak menjawab di grup
# WA2_GROUP_ALLOWED_JIDS=
# WA2_IN_SUMMARY=false               # true = chat nomor kedua ikut ringkasan harian ke pemilik

# ---------------------------------------------------------------- 26. Pembuat gambar (/gambar) -- aktif otomatis bila GEMINI_API_KEYS terisi, semua OPSIONAL
# Grup WA: "bot, buatkan gambar ..." (saklar: /gambar grup on|off di Telegram). Pemilik: chat WA "buatkan gambar ..." atau /gambar di Telegram.
# CLOUDFLARE_ACCOUNT_ID=             # GRATIS: Cloudflare Workers AI (FLUX.1 schnell), ±100-170 gambar/hari tanpa kartu. Dipakai PERTAMA bila diisi.
# CLOUDFLARE_API_TOKEN=              # token dengan izin Workers AI (dash.cloudflare.com > AI > Workers AI > Use REST API)
# CLOUDFLARE_ACCOUNTS=idAkun1:token1,idAkun2:token2   # BEBERAPA akun Cloudflare (jatah gratis dihitung PER AKUN); dipakai bergiliran, akun yang jatahnya habis diistirahatkan sampai 00:00 UTC
# CLOUDFLARE_EDIT_MODELS=@cf/black-forest-labs/flux-2-klein-9b,@cf/black-forest-labs/flux-2-klein-4b   # EDIT FOTO di grup (foto referensi); dicoba berurutan. Butuh ffmpeg (sudo apt install ffmpeg)
# GEMINI_IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3.1-flash-lite-image,gemini-3.1-flash-image,gemini-2.5-flash-image   # dicoba berurutan
# OPENROUTER_IMAGE_MODELS=google/gemini-2.5-flash-image   # cadangan bila Gemini habis (memakai OPENROUTER_API_KEYS yang sama; model gambar OpenRouter memakai kredit)
# IMAGE_PROVIDERS=                   # urutan penyedia: cloudflare,gemini,openrouter. KOSONG = bila Cloudflare terisi, HANYA Cloudflare (Gemini/OpenRouter tidak dipanggil); isi "cloudflare,gemini" untuk mengaktifkan cadangan
# Batas membuat & mengedit gambar DISERAHKAN ke Cloudflare (bawaan 0 = tanpa jatah buatan bot; yang membatasi hanya jatah gratis Cloudflare).
# Isi angka hanya bila ingin batas tambahan (per hari, WITA):
# IMAGE_OWNER_DAILY=0                # jatah gambar pemilik
# IMAGE_GROUP_DAILY=0                # jatah SEMUA grup
# IMAGE_PERSON_DAILY=0               # jatah per orang di grup
# IMAGE_TIMEOUT_MS=90000             # batas tunggu satu permintaan gambar

# ---------------------------------------------------------------- 26b. Pembuat VIDEO gratis ("bot, buatkan video ...", /video) -- video-gen.js
# Dirakit sendiri di laptop: naskah AI -> gambar per adegan (pembuat gambar di atas) -> suara (Gemini TTS) -> ffmpeg. Tanpa API video berbayar.
# Butuh: pembuat gambar aktif (Cloudflare), GEMINI_API_KEYS (suara; tanpa itu video tetap jadi, hanya tanpa suara), ffmpeg (sudo apt install ffmpeg).
# VIDEO_ENABLED=1                    # 0 = matikan
# VIDEO_SCENES=5                     # adegan per video (3-8); satu adegan = satu gambar Cloudflare
# VIDEO_MAX_SCENES=6                 # batas bila diminta durasi ("video 40 detik" ~ 6 dtk/adegan)
# VIDEO_OWNER_DAILY=0                # jatah video pemilik per hari (WITA); 0 = tanpa batas (bawaan). Pemilik yang minta di grup WA juga memakai jatah ini, bukan jatah anggota
# VIDEO_GROUP_DAILY=3                # jatah SEMUA grup per hari
# VIDEO_PERSON_DAILY=1               # jatah per orang di grup per hari
# VIDEO_PHOTO_OWNER_DAILY=0          # FOTO HIDUP (foto -> video + efek, tanpa AI, hanya CPU laptop): jatah pemilik per hari
# VIDEO_PHOTO_GROUP_DAILY=8          # jatah SEMUA grup per hari
# VIDEO_PHOTO_PERSON_DAILY=2         # jatah per orang di grup per hari
# VIDEO_PHOTO_MAX_SEC=15             # durasi maksimum foto hidup (detik)
# --- Morf foto (percobaan, pemilik saja; butuh Cloudflare untuk edit foto): foto + deskripsi -> N edit AI -> video yang berubah
# VIDEO_MORPH_OWNER_DAILY=4          # jatah morf pemilik per hari (tiap morf = VIDEO_MORPH_STEPS edit foto); 0 = tanpa batas
# VIDEO_MORPH_STEPS=5                # tahap edit bawaan (2-8)
# VIDEO_MORPH_MAX_STEPS=8            # tahap maksimum bila diminta ("8 tahap")
# VIDEO_MORPH_SECONDS=8              # durasi bawaan (detik)
# VIDEO_MORPH_MAX_SEC=14             # durasi maksimum
# VIDEO_MORPH_CHAIN=0                # 1 = tiap tahap diedit dari hasil tahap sebelumnya (lebih mulus tetapi wajah/warna bisa makin menyimpang); 0 = selalu dari foto asli
# --- Stop motion dari foto berurutan (Telegram /stopmotion; hanya CPU; memakai jatah foto hidup pemilik)
# VIDEO_STOP_MAX_PHOTOS=60           # foto maksimum per sesi (6-120)
# VIDEO_STOP_MAX_FPS=15              # gambar per detik maksimum yang boleh diminta (4-24)
# Musik latar video: taruh lagu (mp3/m4a/wav/ogg...) di folder wa-bot/musik/ (boleh subfolder: musik/dj/, musik/tenang/)
# VIDEO_MUSIC_DIR=                   # folder lain (kosong = wa-bot/musik)
# VIDEO_MUSIC_VOLUME=60              # volume musik (10-100)
# VIDEO_MUSIC_DEFAULT=0              # 1 = semua video otomatis diberi musik (kalau folder ada isinya); bisa dimatikan per video dengan "tanpa musik"
# VIDEO_NARRATION_CHARS=620          # batas total huruf narasi yang dibacakan
# VIDEO_FONT=                        # berkas font subtitle (kosong = DejaVu Sans Bold bila ada)
# VIDEO_QUEUE=2                      # banyak permintaan boleh mengantre (satu video dirakit pada satu waktu)

# ---------------------------------------------------------------- 27. Uji Meta AI (/metaai) -- PERCOBAAN, hanya dari Telegram, nomor utama
# META_AI_JIDS=13135550002@s.whatsapp.net   # alamat Meta AI yang dicoba /metaai tes (pisah koma); temukan alamat asli lewat /metaai cari

# ---------------------------------------------------------------- 28. Kantor AI (halaman "Kantor" di aplikasi) -- aktif bawaan, OPSIONAL
# Bot memancarkan RINGKASAN kegiatan (mis. "Menyusun balasan di grup Keluarga") ke tabel office_events/office_presence di Supabase
# supaya halaman Kantor menampilkan kerja Ayyubi, Wongsobot, Agen Lokal (= Ollama di server Linux ini), dan studio gambar/video/suara. Isi pesan TIDAK pernah dikirim;
# nomor telepon/surel/tautan disamarkan; chat pribadi hanya tertulis "chat pribadi". Butuh migrasi 0041_office.sql.
# OFFICE_FEED=1                      # 0 = matikan pemancar

# ---------------------------------------------------------------- 25. Mode humor grup WhatsApp (/humor di Telegram, bawaan MATI) -- semua OPSIONAL
# Dinyalakan per grup dari Telegram: /humor on <nomor|nama>. Pengaturan disimpan di bot_state, tidak perlu menyentuh .env.
# WA_HUMOR_PANTUN_WINDOW=08:00-20:00  # rentang jam (zona WA_TIMEZONE) untuk memilih jam acak pantun harian; bisa dibeda-bedakan per grup lewat /humor jam
# WA_HUMOR_ROAST_MAX_PER_DAY=5        # jatah roasting spontan per grup per hari (0 = tidak pernah)
# WA_HUMOR_ROAST_COOLDOWN_MIN=45      # jeda minimal antar-roasting di satu grup (menit)
# WA_HUMOR_ROAST_CHANCE=0.15          # peluang tiap pesan "layak" memicu roasting (0-1)
# WA_HUMOR_ROAST_WINDOW=08:00-21:00   # roasting hanya di rentang jam ini
# WA_HUMOR_ROAST_OWNER=false          # true = pemilik nomor boleh ikut diroasting
# --- balas chat acak (reply setelah membaca 15 chat sebelumnya) & chat otomatis harian; dinyalakan lewat /humor balas on / /humor sapa on
# WA_BALAS_CONTEXT=15                 # jumlah chat sebelumnya yang dibaca sebelum membalas (5-30)
# WA_BALAS_CHANCE=0.2                 # peluang tiap chat dibalas (0-1); pertanyaan lebih sering
# WA_BALAS_GAP_MIN=3                  # jeda minimal (menit) sejak bot terakhir bicara di grup itu
# WA_BALAS_MAX_PER_DAY=0              # batas balasan acak per grup per hari (0 = TANPA batas; diatur peluang, jeda, energi & kelelahan)
# WA_BALAS_WINDOW=00:00-23:59         # jam boleh membalas (bawaan 24 jam; di jam tidur tetap dibatasi WA_JAM_TIDUR)
# WA_SAPA_PER_DAY=10                  # chat otomatis per grup per hari (minimal 10, maks 48)
# WA_SAPA_MIN_GAP_MIN=10              # jarak minimal antar chat otomatis (menit)
# WA_SAPA_WINDOW=06:00-21:30          # jam boleh membuka obrolan (bawaan 06:00-21:30; jam tidur tetap tidak dipakai)
# WA_JAM_TIDUR=22:30-05:00            # jam tidur: bot tidak membuka obrolan/stiker, membalas hanya saat obrolan ramai. "off" = tanpa jam tidur
# WA_TIDUR_BALAS_FACTOR=0.2           # di jam tidur peluang membalas dikali ini (0-1)
# --- lapisan manusiawi (reaksi emoji, momen, kepribadian); mode latihan & ingatan anggota diatur dari Telegram/WhatsApp, bukan .env
# WA_REAKSI_CHANCE=0.3                # peluang pesan bernuansa (lucu/kabar baik/terima kasih/selamat/mantap) diberi reaksi emoji
# WA_REAKSI_GAP_SEC=45                # jeda minimal antar-reaksi di satu grup (detik)
# WA_REAKSI_MAX_PER_DAY=0             # batas reaksi per grup per hari (0 = tanpa batas)
# WA_HARI_KHUSUS=03-19=Hari Raya Nyepi;12-25=Natal   # hari khusus lokal untuk bahan chat otomatis (MM-DD=Teks;...)
# --- baca gambar & stiker (/humor lihat on <grup>); butuh GEMINI_API_KEYS
# WA_LIHAT_PER_DAY=30                 # jatah panggilan AI penglihatan per grup per hari (membaca foto + melabeli stiker baru)
# WA_LIHAT_GAMBAR_MAX_MB=4            # gambar lebih besar dari ini tidak dibaca
# WA_LIHAT_TANYA_PER_DAY=10           # jatah "bot, ini gambar apa?" per orang per hari (0 = mati)
# WA_FOTO_BALAS_FACTOR=1.5            # foto lebih sering dikomentari daripada chat biasa (pengali WA_BALAS_CHANCE)
# WA_STIKER_CHANCE=0.12               # peluang membalas stiker orang dengan stiker (0.7 bila stikernya me-reply bot)
# WA_STIKER_GAP_MIN=10                # jeda minimal antar-stiker bot per grup (menit)
# WA_STIKER_TEKS_FACTOR=0.5          # stiker berlabel kadang ditanggapi satu kalimat (pengali WA_BALAS_CHANCE)
# WA_STIKER_MAX_PER_DAY=0             # batas stiker bot per grup per hari (0 = tanpa batas; -1 = bot tidak pernah mengirim stiker)
# --- makin manusiawi (tahap 2)
# WA_ENERGI_HARIAN=on                 # suasana hati harian (kalem/biasa/semangat) + ritme jam + kelelahan memengaruhi peluang & jeda membalas
# WA_GAYA_ALAMI=on                    # balasan dirapikan mengikuti gaya tulis grup (huruf kecil, udah/aja/nggak, tanpa titik akhir, ikut tertawa)
# WA_TYPO_CHANCE=0.03                 # peluang salah ketik kecil yang langsung dikoreksi (*kata); 0 = tidak pernah
# WA_LANJUT_CHANCE=0.55               # peluang menyahut orang yang BARU dibalas bot lalu menulis lagi (tanpa menunggu jeda)
# WA_LANJUT_MENIT=4                   # lanjutan obrolan berlaku sekian menit setelah balasan bot
# WA_LANJUT_MAKS=2                    # maksimal sahutan beruntun ke orang yang sama (0 = tanpa lanjutan)
# WA_TANYA_TANPA_MENTION=on          # pertanyaan anggota di grup (/humor balas on) dijawab walau bot tidak di-mention; off = hanya bila dipanggil
# WA_TANYA_CHANCE=0.85                # peluang menjawab pertanyaan yang tidak ditujukan ke satu orang (0-1)
# WA_TANYA_GAP_SEC=15                 # jeda minimal (detik) sejak bot terakhir bicara sebelum menjawab pertanyaan
# WA_AKHIR_PEKAN_DIAM=on              # on = Sabtu & Minggu tanpa inisiatif (tidak menyapa/pantun/roast/ucapan sendiri, hanya membalas); off = tetap aktif
# WA_HARI_DIAM=Sabtu,Minggu           # hari tanpa inisiatif (nama hari Indonesia, pisah koma); isi "off" untuk tanpa hari diam
# WA_INGAT_HARI=60                    # (butuh /humor ingat on <grup>) hal ringan yang diceritakan sendiri dilupakan setelah sekian hari
# WA_KOLEKSI_MAX=100                 # jumlah stiker koleksi pemilik (kirim stiker ke chat "Pesan untuk diri sendiri")
# WA_STIKER_DARI_PEMILIK=false        # true = stiker yang kamu kirim dari HP ke chat/grup mana pun otomatis masuk koleksi
# WA_STIKER_MAX=40                    # jumlah stiker tersimpan per grup (5-200)
# WA_STICKER_DIR=./data-stiker        # folder berkas stiker yang dipelajari
# WA_PERSONA_NOTE=Suka bercanda receh, sesekali pakai logat Bali ringan   # ciri tambahan Ayyubi (maks 400 huruf)

# ================================================================
# Baca dokumen lebih pintar: Jina (pencarian makna + reranker), kalkulator SBM, PDF di chat pribadi, acuan publik
# ================================================================
# --- Jina (opsional; tanpa key bot tetap jalan persis seperti dulu: BM25 saja)
# Isi KEY LANGSUNG DI FILE INI di laptop/hub -- jangan kirim ke chat, jangan di-commit. Beberapa key dipisah koma (dirotasi bergiliran).
# JINA_API_KEYS=jina_xxx,jina_yyy,jina_zzz,jina_www
# JINA_ENABLED=true                   # false = matikan Jina walau key ada
# JINA_EMBED=true                     # vektor makna (hanya dokumen NON-lokal: acuan publik & dokumen aplikasi)
# JINA_RERANK=true                    # urutkan ulang kandidat dengan reranker
# JINA_EMBED_MODEL=jina-embeddings-v3
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# JINA_RERANK_MIN=0.05                # skor reranker minimal agar potongan dipakai (BELUM dikalibrasi -- lihat README)
# JINA_DENSE_MIN=0.4                  # kemiripan vektor minimal bila tanpa reranker (BELUM dikalibrasi)
# JINA_DEADLINE_MS=9000               # batas waktu total Jina per pertanyaan; lewat itu otomatis kembali ke BM25
# JINA_READER=false                   # true = /jina baca <url> aktif (mengirim ALAMAT URL ke r.jina.ai -- pihak ketiga)
# --- Kalkulator SBM perjalanan dinas dalam negeri (data dari PMK 32/2025, dihitung kode, bukan AI)
# SBM_ENABLED=true
# SBM_DATA_FILE=./data/sbm-pmk32-2025.json   # tahun depan: node sbm-build.mjs <PMK-baru.pdf> data/sbm-pmk-baru.json
# --- PDF di chat pribadi & grup (semua halaman terbaca, jawaban dikutip per halaman)
# WA_DM_PDF_READ=on                   # off = bot tidak membaca PDF di chat pribadi
# WA_PDF_MAX_PAGES=300                # batas halaman yang dibaca per PDF (maks 400)
# --- Perpustakaan acuan PUBLIK: taruh PDF peraturan terbuka (mis. PMK 32 Tahun 2025) di <DOC_DIR>/acuan-publik/
# Seluruh halaman diindeks (id "acuan:") dan boleh dijawab lewat Gemini/Groq/Jina. JANGAN taruh dokumen internal di sini
# (dokumen internal seperti Komitmen Bersama PPK -> peraturan-pdf/, khusus lokal; lihat /komitmen).
# ACUAN_ENABLED=true
# ACUAN_DIR=/home/abuayyubb/ringkasan_harian/dokumen/acuan-publik
# ACUAN_MAX_PAGES=1000

# ================================================================
# Channel YouTube edukasi SD (kelas 1-6): video papan tulis dibuat otomatis, kamu setujui di Telegram, lalu terjadwal tayang
# ================================================================
# EDU_ENABLED=false                   # true = aktifkan pembuatan harian
# EDU_CHANNEL_NAME=Belajar Bareng     # tampil kecil di pojok video & sampul
# EDU_RENDER_TIME=02:00               # video baru dibuat tiap hari mulai jam ini (zona WA_TIMEZONE)
# EDU_PUBLISH_TIME=16:00              # jam tayang di YouTube; satu video per hari
# EDU_MODE=motion                     # motion = Short motion graphic 9:16 (bawaan, lihat motion/README.md); papan = video papan tulis lama
# TEMA_OTOMATIS=1                     # 0 = tema mingguan TIDAK disetujui otomatis Minggu 21:00 bila pemilik belum menjawab
# EDU_TEMA_FILE=data/tema-mingguan.json  # status usulan tema mingguan (dibuat otomatis)
# EDU_MAX_PENDING=3                   # berhenti membuat bila segini draf belum kamu setujui/buang
# EDU_GRADES=1,2,3,4,5,6              # kelas yang dibuat (diputar bergiliran)
# EDU_MIX=math:2,sains:1              # perbandingan matematika : IPA/pengetahuan umum
# EDU_PRACTICE=1                      # jumlah soal latihan per video matematika
# EDU_MIN_SEC=60                      # panjang video 60-120 detik
# EDU_MAX_SEC=120
# EDU_VOICE=                          # nama suara Gemini (kosong = suara bawaan bot)
# EDU_STYLE=Ramah, jelas, dan sabar seperti guru SD yang menyenangkan
# EDU_KEEP_DAYS=14                    # berkas video yang sudah terjadwal disimpan segini hari
# EDU_DIR=edu-data
# --- YouTube (isi di file ini; YT_REFRESH_TOKEN dibuat otomatis oleh `node youtube-auth.mjs`, jangan disalin ke chat)
# YT_CLIENT_ID=xxxx.apps.googleusercontent.com
# YT_CLIENT_SECRET=GOCSPX-xxxx
# YT_REFRESH_TOKEN=
# YT_CATEGORY=27                      # 27 = Pendidikan
# YT_LANG=id
# YT_MADE_FOR_KIDS=true               # konten untuk anak SD: komentar & iklan personalisasi dinonaktifkan YouTube
# YT_AI_DISCLOSURE=true               # beri label "konten sintetis" (suara narasi AI)

# ---------- Baca tautan & video di chat (link-read.js, video-read.js) ----------
# Semua opsional; nilai di bawah = bawaan aman. Berlaku di chat pribadi dan grup yang diizinkan.
# LINK_READ_ENABLED=true              # false = bot tidak membaca tautan/video sama sekali
# LINK_MAX_URLS=2                     # maks tautan yang dibaca per pesan (pesan sendiri + pesan yang dibalas)
# LINK_CONTEXT_CHARS=6000             # total karakter isi tautan yang masuk prompt (dipotong bila lebih)
# LINK_FETCH_TIMEOUT_MS=12000         # batas waktu unduhan langsung (cadangan bila Jina Reader mati/gagal)
# LINK_FETCH_MAX_KB=1500              # batas ukuran halaman yang diunduh
# LINK_PER_USER_DAILY=10              # jatah baca tautan+video per orang per hari
# LINK_PER_GROUP_DAILY=40             # jatah per grup per hari
# LINK_CACHE_HOURS=6                  # hasil baca disimpan segini jam (URL sama tidak diunduh ulang)
# LINK_YOUTUBE_GEMINI=true            # YouTube: minta Gemini menonton video dari URL publik (pratinjau Google; gratis maks 8 jam video/hari)
# LINK_YOUTUBE_TIMEOUT_MS=90000
# Web biasa dibaca lewat Jina Reader bila JINA_READER aktif (lihat bagian Jina); selain itu unduhan langsung yang dijaga.
# Tingkat transkrip YouTube BELUM dipasang (butuh dependensi baru); bila Gemini gagal bot memakai judul + kanal + deskripsi dan berterus terang.
# Video yang diunggah/dibalas di WA (butuh ffmpeg untuk video besar):
# VIDEO_MAX_SECONDS=300               # lebih panjang dari ini ditolak
# VIDEO_MAX_MB=25                     # lebih besar dari ini ditolak
# VIDEO_INLINE_MB=12                  # sampai ukuran ini dikirim utuh ke Gemini; lebih besar = bingkai + audio lewat ffmpeg
# VIDEO_FRAMES=6                      # jumlah cuplikan gambar untuk video besar

# ---------- Rantai balasan antar-bot (bot-chain.js) ----------
# Ayyubi dan Wongsobot BOLEH saling menyahut di grup; ini hanya pengamannya.
# BOT_CHAIN_MAX=6                     # maks pesan bot berturut-turut tanpa pesan manusia; lewat ini bot berhenti menyahut sampai ada manusia yang bicara (0 = tidak menyahut bot lain)
# BOT_CHAIN_DELAY_MIN_SEC=3           # jeda acak sebelum menyahut pesan bot lain
# BOT_CHAIN_DELAY_MAX_SEC=10
