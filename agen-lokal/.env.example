# Salin berkas ini menjadi ".env" lalu isi. Baris berawalan # diabaikan.

# --- Telegram (wajib) ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Id Telegram-mu (angka). Kosongkan dulu, jalankan bot, kirim pesan apa saja: bot membalas id-mu. Lalu isi di sini.
TELEGRAM_OWNER_IDS=

# --- Model lokal (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:7b = seimbang (±5 GB RAM, ±5-10 kata/detik di CPU i7). Lebih cepat tetapi lebih bodoh: qwen2.5:3b. Alternatif 8B: llama3.1:8b
OLLAMA_MODEL=qwen2.5:7b
# panjang konteks (token). 8192 ±1 GB RAM tambahan; naikkan bila RAM longgar
OLLAMA_NUM_CTX=8192
# model dibiarkan di RAM selama ini setelah dipakai (supaya jawaban berikutnya tidak menunggu muat ulang)
OLLAMA_KEEP_ALIVE=30m

# --- Keamanan ---
# Folder yang boleh DIBACA/DIUBAH alat berkas agent, pisahkan dengan titik-koma (;). "~" = folder rumah.
# Linux : AGENT_ROOTS=~/Dokumen;~/Unduhan      Windows: AGENT_ROOTS=C:\Users\NamaKamu\Documents;D:\Kerja
# JANGAN masukkan folder proyek Ayyubi / wa-bot (isinya token dan sesi WhatsApp) dan jangan isi "/" atau "~" saja.
# Catatan: ini membatasi alat berkas. Perintah shell (jalankan_perintah) tetap hanya jalan setelah kamu tekan Ya, dan berkas rahasia (.env, kunci SSH, auth_session) ditolak di semua alat.
AGENT_ROOTS=
# Folder kerja (harus di dalam salah satu AGENT_ROOTS): tempat file baru dibuat bila alamat tidak lengkap, dan tempat "sampah" (file yang dihapus dipindah ke sini, bukan dihapus permanen)
AGENT_WORKDIR=
# Mode persetujuan: tanya (bawaan: ubah file & jalankan perintah selalu minta tombol Ya/Tidak) | baca (hanya membaca, semua perubahan ditolak)
AGENT_MODE=tanya
# Detik menunggu jawaban Ya/Tidak sebelum dianggap Tidak
AGENT_APPROVAL_TIMEOUT_SEC=300
# Maksimal langkah alat per pertanyaan
AGENT_MAX_STEPS=8
# Batas waktu satu perintah (bash di Linux, PowerShell di Windows), dalam detik
AGENT_COMMAND_TIMEOUT_SEC=60
